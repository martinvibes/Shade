# ══════════════════════════════════════
# SHADE — Environment Config Template
# Copy to .env and fill in your values
# ══════════════════════════════════════

# ── Wallet ──
PRIVATE_KEY=0xyour_private_key_here
DEPLOYER_ADDRESS=0xyour_address_here

# ── Venice AI (https://venice.ai/settings/api) ──
VENICE_API_KEY=your_venice_key_here

# ── Locus Payments ──
LOCUS_API_KEY=claw_dev_your_key_here
LOCUS_WALLET_ADDRESS=0xyour_locus_wallet

# ── WalletConnect (https://cloud.walletconnect.com) ──
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id

# ── Agent Settings ──
MAX_SPEND_PER_TX=10
DAILY_BUDGET=50
PRIVACY_LEVEL=high
PORT=3001
